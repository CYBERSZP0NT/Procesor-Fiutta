# FreeLLM Router — put your free-tier keys here (all optional).
# Each one is free within the vendor's published limits; unset ones are skipped.

# Google AI Studio (Gemini free tier)
GOOGLE_API_KEY=
# Groq (~14,400 req/day free)
GROQ_API_KEY=
# OpenRouter (":"-free models, 50 req/day / 1000 req/month free)
OPENROUTER_API_KEY=
# Cerebras (~3000 req/day free)
CEREBRAS_API_KEY=
# SambaNova (750M tokens/month free)
SAMBANOVA_API_KEY=
# Mistral La Plateforme (500k tokens/month per model)
MISTRAL_API_KEY=
# Z.ai / Zhipu (GLM free tier)
ZAI_API_KEY=
# NVIDIA NIM (1000 free req per model)
NVIDIA_API_KEY=
# GitHub Models (15 req/min, 150 req/day; works with a classic PAT)
GITHUB_TOKEN=
# Cohere trial key
COHERE_API_KEY=

# FreeLLMAPI Premium "live" license (fla_…). When it works, the task router
# defaults to mode "live" (by richness, signed live catalog). Check it:
# szmelc-router live. Off switch: FREELLM_LIVE=off.
FREELLM_API_KEY=

# Optional sidecars (if you ALSO run them):
LLMCYCLE_API_KEY=
LLMCYCLE_URL=http://localhost:8000
# FreeLLMAPI server you run yourself: unified key (freellmapi-…) + base URL
# without /v1 (its default port is 3001).
FREELLMAPI_API_KEY=
FREELLMAPI_URL=http://localhost:3001

# Point the router at a non-default Ollama (e.g. your Pi):
# OLLAMA_BASE_URL=http://pi.local:11434
